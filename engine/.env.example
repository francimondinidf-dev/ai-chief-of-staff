# Chief of Staff - your personal settings.
# Copy this file to .env in the same folder and fill it in. .env is gitignored;
# never commit a filled-in copy.

# --- Who you are (required) ---------------------------------------------------
# One line describing your role; it frames what counts as "your" commitment.
# COS_USER_ROLE=an investor at a growth-equity fund
# The brief is emailed to this address, and it is how "you" is recognised in
# emails and call transcripts.
COS_USER_EMAIL=you@example.com
COS_USER_NAME=Firstname LASTNAME

# --- Notion (for call transcripts) --------------------------------------------
# An internal-integration token with read access to the calls database(s).
# Notion -> Settings -> Connections -> Develop or manage integrations -> New.
# Then open each database -> ... -> Connections -> add your integration.
NOTION_API_KEY=

# A shared team calls database, filtered to calls you created or attended.
COS_NOTION_TEAM_CALLS_DB=

# Notion "people" properties that list who attended a call (comma-separated).
# COS_NOTION_PEOPLE_PROPS=Attendees,Participants

# Optional: your own private calls database (every row is read, no filter).
COS_NOTION_PRIVATE_CALLS_DB=

# Optional but recommended: your Notion user id, used to recognise calls you
# attended. If blank, attendance is matched on COS_USER_EMAIL instead.
COS_NOTION_USER_ID=

# --- Claude ---------------------------------------------------------------------
# Default "cc" runs through your Claude Code login (subscription, no API key).
# COS_BACKEND=cc
# Only needed if you set COS_BACKEND=api, or want a metered fallback.
# ANTHROPIC_API_KEY=

# --- Tuning (defaults shown) -----------------------------------------------------
# COS_COLD_START_DAYS=14      how far back the very first run reads
# COS_STALE_AFTER_DAYS=21     untouched items move to "still real?"
# COS_MODEL_EXTRACT=claude-sonnet-5
# COS_MODEL_REASON=claude-sonnet-5
